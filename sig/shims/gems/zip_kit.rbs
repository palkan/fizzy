# zip_kit isn't in gem_rbs_collection. The gem ships signatures in rbi/zip_kit.rbs, which this follows.
module ZipKit
  class RemoteIO
    @pos: Integer
    @uri: URI::Generic
    @remote_size: Integer?

    def initialize: (String | URI::Generic url) -> void
    def seek: (Integer offset, ?Integer mode) -> Integer
    def size: () -> Integer
    def read: (?Integer? n_bytes) -> String?
    def tell: () -> Integer

    private

    def request_range: (Range[Integer] range) -> String
    def request_object_size: () -> Integer
    def clamp: (Integer a, Integer b, Integer c) -> Integer
  end
end

# The parts of zip_kit used by ZipFile, from the signatures it ships in rbi/zip_kit.rbs
module ZipKit
  class FileReader
    class ReadError < StandardError
    end

    class UnsupportedFeature < StandardError
    end

    class MissingEOCD < StandardError
    end

    def self.read_zip_structure: (io: untyped, ?read_local_headers: bool) -> Array[ZipEntry]

    interface _Extractor
      def extract: (?Integer? n_bytes) -> String?
      def eof?: () -> bool
    end

    class ZipEntry
      attr_accessor filename: String
      attr_accessor uncompressed_size: Integer

      def extractor_from: (untyped from_io) -> _Extractor
    end
  end

  class Streamer
    def initialize: (untyped writable, ?auto_rename_duplicate_filenames: bool) -> void
    def write_stored_file: (String filename, ?modification_time: Time, ?unix_permissions: Integer?) ?{ (Streamer::Writable sink) -> void } -> Streamer::Writable
    def write_deflated_file: (String filename, ?modification_time: Time, ?unix_permissions: Integer?) ?{ (Streamer::Writable sink) -> void } -> Streamer::Writable
    def close: () -> Integer

    class Writable
      def <<: (String string) -> self
      def write: (String bytes) -> Integer
      def close: () -> untyped
    end
  end
end
