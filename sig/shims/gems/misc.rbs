# Gaps in signatures of gems and standard libraries

module SecureRandom
  # Added by Active Support
  BASE32_ALPHABET: Array[String]

  def self.base32: (?Integer n) -> String
end

module Nokogiri
  # The collection's signatures predate Nokogiri's HTML5 parser
  def self.HTML5: (String? input, ?untyped url, ?untyped encoding, **untyped options) -> Nokogiri::HTML::Document
end

# lib/web_push/pool.rb
module Concurrent
  class ThreadPoolExecutor
    include ExecutorService

    def initialize: (?::Hash[Symbol, untyped] opts) -> void
    def shutdown: () -> bool
    def kill: () -> bool
    def wait_for_termination: (?Numeric? timeout) -> bool
  end

  class RejectedExecutionError < StandardError
  end
end

# net-http-persistent ships no signatures
class Net::HTTP::Persistent
  def initialize: (?name: String?, ?proxy: untyped, ?pool_size: Integer) -> void
  def request: (URI::Generic | String uri, ?Net::HTTPRequest? req) -> Net::HTTPResponse
  def shutdown: () -> void
end

# The digest may be a name or nil (for algorithms without a separate digest, like Ed25519)
class OpenSSL::PKey::PKey
  def verify: (OpenSSL::Digest | String | nil digest, String signature, String data, ?Hash[String, String] options) -> bool
            | ...
end

# Absent from the globalid collection signatures
class GlobalID
  module Locator
    def self.locate: (GlobalID | String gid, ?untyped options) -> untyped
  end
end

# Added in Ruby 3.3, absent from the socket stdlib signatures
class Socket
  class ResolutionError < SocketError
    def error_code: () -> Integer
  end
end

# sentry-ruby, bundled in SaaS mode only
module Sentry
  def self.capture_exception: (Exception exception, **untyped options) -> untyped
end

# importmap-rails
class ActionController::Base
  def self.stale_when_importmap_changes: () -> void
end

module Aws
  module S3
    class MultipartUploadError < StandardError
      def errors: () -> Array[StandardError]
    end
  end
end

module Mittens
  class Stemmer
    def initialize: () -> void
    def stem: (String word) -> String
  end
end
