# platform_agent ships no signatures and isn't in gem_rbs_collection
class PlatformAgent
  def initialize: (String? user_agent_string) -> void

  def desktop?: () -> bool
  def mobile?: () -> bool
  def phone?: () -> bool
  def iphone?: () -> bool
  def android_phone?: () -> bool
  def other_phones?: () -> bool
  def tablet?: () -> bool
  def ipad?: () -> bool
  def android?: () -> bool
  def native_app?: () -> bool
  def mobile_app?: () -> bool
  def iphone_app?: () -> bool
  def ipad_app?: () -> bool
  def ios_app?: () -> bool
  def android_app?: () -> bool
  def desktop_app?: () -> bool
  def mac_app?: () -> bool
  def windows_app?: () -> bool
  def missing?: () -> bool
  def app_version: () -> String?
  def to_s: () -> String

  private

  attr_accessor user_agent_string: String?

  def match?: (Regexp | String pattern) -> bool
  def user_agent: () -> UserAgent
end

# useragent
class UserAgent
  def self.parse: (String? string) -> UserAgent

  def browser: () -> String
  def platform: () -> String?
  def os: () -> String?
  def version: () -> untyped
  def to_s: () -> String
end

# PlatformAgent delegates
# `browser, version, product, os` to its UserAgent.
class PlatformAgent
  def os: () -> String?
end
