# lexxy ships no signatures and isn't in gem_rbs_collection

class ActionText::Attachables::RemoteVideo
  extend ActiveModel::Naming

  def self.from_node: (untyped node) -> ActionText::Attachables::RemoteVideo?

  attr_reader url: String?
  attr_reader content_type: String?
  attr_reader width: String?
  attr_reader height: String?
  attr_reader filename: String?

  def initialize: (?Hash[Symbol, untyped] attributes) -> void
  def attachable_plain_text_representation: (String? caption) -> String
  def to_partial_path: () -> String
end
