# Model declarations that inline RBS and the generators can't express: concern contracts,
# association extensions, aliases, `store_accessor`s, `class_attribute`s, and dynamic predicates.

# Contracts of the shared concerns in app/models/concerns: what each concern needs from the
# record that includes it. They type `self` as `<Concern> & <Concern>::_Includer & ApplicationRecord`.

module Searchable
  interface _Includer
    def account_id: () -> String
    def created_at: () -> ActiveSupport::TimeWithZone
    def search_title: () -> String?
    def search_content: () -> String?
    def search_card_id: () -> String
    def search_board_id: () -> String
    def searchable?: () -> bool
  end
end

module Mentions
  interface _Includer
    def board: () -> Board
  end
end

module Eventable
  interface _Includer
    def board: () -> Board
  end
end

module Filterable
  interface _Includer
    def filters: () -> Filter::ActiveRecord_Associations_CollectionProxy
  end
end

module Storage::Totaled
  interface _Includer
    # Declared by the concern's `included` block
    def storage_total: () -> Storage::Total?
    def storage_total=: (Storage::Total?) -> Storage::Total?
    def storage_entries: () -> Storage::Entry::ActiveRecord_Associations_CollectionProxy

    # Only called on includers other than Account
    def account: () -> Account
  end
end

module Storage::Tracked
  interface _Includer
    def account: () -> Account
    def board: () -> Board
  end
end

# Template methods Notifier subclasses (app/models/notifier/) implement.
class Notifier
  private

  def recipients: () -> Enumerable[User]
  def creator: () -> User
end

class Notifier
  # Event notifiers are only built for events (see Notifier.for)
  interface _EventSource
    def source: () -> Event
  end

  # Mention notifiers are only built for mentions
  interface _MentionSource
    def source: () -> Mention
    def mention: () -> Mention
  end
end

class Board
  # Extension methods of the `accesses` association (app/models/board/accessible.rb)
  interface _AccessesExtension
    def revise: (?granted: Enumerable[User], ?revoked: Enumerable[User]) -> void
    def grant_to: (User | Enumerable[User]) -> void
    def revoke_from: (User | Enumerable[User]) -> void
  end

  def accesses: () -> (Access::ActiveRecord_Associations_CollectionProxy & _AccessesExtension) | ...
end

# Filter::Fields wraps these values in ActiveSupport::StringInquirer, whose predicates are dynamic

class Filter
  interface _IndexedBy
    def all?: () -> bool
    def closed?: () -> bool
    def not_now?: () -> bool
    def stalled?: () -> bool
    def postponing_soon?: () -> bool
    def golden?: () -> bool
  end

  interface _SortedBy
    def newest?: () -> bool
    def oldest?: () -> bool
    def latest?: () -> bool
  end

  interface _AssignmentStatus
    def unassigned?: () -> bool
  end
end

# Event#action wraps the action in ActiveSupport::StringInquirer, whose predicates are dynamic

class Event
  interface _Action
    def card_assigned?: () -> bool
    def card_unassigned?: () -> bool
    def card_published?: () -> bool
    def card_closed?: () -> bool
    def card_reopened?: () -> bool
    def card_postponed?: () -> bool
    def card_auto_postponed?: () -> bool
    def card_resumed?: () -> bool
    def card_title_changed?: () -> bool
    def card_board_changed?: () -> bool
    def card_collection_changed?: () -> bool
    def card_triaged?: () -> bool
    def card_sent_back_to_triage?: () -> bool
    def comment_created?: () -> bool
  end
end

# A model class handled by an Account::DataTransfer::RecordSet
type Account::DataTransfer::RecordSet::model = singleton(ActiveRecord::Base) & ActiveRecord::Base::ClassMethods[untyped, untyped, untyped]

# Defined in config/initializers/tenanting/account_slug.rb, outside the checked paths
module AccountSlug
  PATTERN: Regexp
  PATH_INFO_MATCH: Regexp

  def self.encode: (Integer id) -> String
  def self.decode: (String slug) -> Integer
end

# The IO a zip is read from: a local file or a ZipFile::RemoteIO
interface ZipFile::Reader::_IO
  def read: (Integer) -> String?
  def seek: (Integer, ?Integer) -> Integer
  def tell: () -> Integer
  def size: () -> Integer
end

# The IO a zip is written to: a local file or an S3 upload stream
interface ZipFile::Writer::_Output
  def write: (String) -> Integer
end

class Account
  # Created after the account is created
  def join_code: () -> Account::JoinCode | ...
end

class Webhook
  # Created after the webhook is created
  def delinquency_tracker: () -> Webhook::DelinquencyTracker | ...
end

class Webhook::DelinquencyTracker
  # Defaults to 0
  def consecutive_failures_count: () -> Integer | ...
end

class Webhook::Delivery
  include ActionDispatch::Routing::PolymorphicRoutes

  # Serialized with `store`
  def response=: (Hash[Symbol, untyped]) -> Hash[Symbol, untyped] | ...
end

# Active Record dynamic finders
class Identity
  def self.find_by_email_address: (String? email_address) -> Identity?
end

module Card::GeneratedRelationMethods
  def find_by_id: (untyped id) -> Card?
end

# Model class methods called on relations, which rbs_rails doesn't carry over
module Filter::GeneratedRelationMethods
  def from_params: (untyped params) -> Filter
  def remember: (untyped attrs) -> Filter
end

module Notification::GeneratedRelationMethods
  def read_all: () -> Array[Notification]
end

# Enum scopes declared on the STI parent, Export
module Account::Export::GeneratedRelationMethods
  def completed: () -> Account::Export::ActiveRecord_Relation
end
