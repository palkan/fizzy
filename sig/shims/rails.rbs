# Fills gaps in the Rails signatures from gem_rbs_collection

class Rails::Application::Configuration
  # Configured in lib/action_pack/railtie.rb
  def action_pack: () -> ActionPack::_Configuration
  def action_mailer: () -> ActionMailer::_Configuration
end

module ActionMailer
  interface _Configuration
    def default_url_options: () -> Hash[Symbol, untyped]?
  end
end

module ActionPack
  interface _Configuration
    def web_authn: () -> _WebAuthnConfiguration
    def web_authn=: (ActiveSupport::OrderedOptions) -> ActiveSupport::OrderedOptions
    def passkey: () -> _PasskeyConfiguration
    def passkey=: (ActiveSupport::OrderedOptions) -> ActiveSupport::OrderedOptions
  end

  interface _WebAuthnConfiguration
    def default_request_options: () -> Hash[Symbol, untyped]
    def default_creation_options: () -> Hash[Symbol, untyped]
    def creation_challenge_expiration: () -> ActiveSupport::Duration
    def request_challenge_expiration: () -> ActiveSupport::Duration
    def default_request_options=: (Hash[Symbol, untyped]) -> Hash[Symbol, untyped]
    def default_creation_options=: (Hash[Symbol, untyped]) -> Hash[Symbol, untyped]
    def creation_challenge_expiration=: (ActiveSupport::Duration) -> ActiveSupport::Duration
    def request_challenge_expiration=: (ActiveSupport::Duration) -> ActiveSupport::Duration
  end

  interface _PasskeyConfiguration
    def parent_class_name: () -> String
    def routes_prefix: () -> String
    def draw_routes: () -> bool
    # Evaluated in the view with instance_exec
    def challenge_url: () -> (^() [self: ActionView::Base] -> String)?
    def parent_class_name=: (String) -> String
    def routes_prefix=: (String) -> String
    def draw_routes=: (bool) -> bool
    def challenge_url=: ((^() [self: ActionView::Base] -> String)?) -> untyped
  end
end

class ActionDispatch::Routing::RouteSet
  def url_helpers: (?bool supports_path) -> (Module & ::_RbsRailsPathHelpers) | ...
end

class ActionController::Base
  # Route proxies for mounted engines
  def main_app: () -> ::_RbsRailsPathHelpers
end

class ActionView::Base
  def main_app: () -> ::_RbsRailsPathHelpers
end

# Framework models whose collection signatures lack Active Record's class methods
class ActiveStorage::Attachment
  extend ActiveRecord::Base::ClassMethods[ActiveStorage::Attachment, untyped, Integer | String]
end

class ActiveStorage::Blob
  extend ActiveRecord::Base::ClassMethods[ActiveStorage::Blob, untyped, Integer | String]
end

class ActionText::RichText
  extend ActiveRecord::Base::ClassMethods[ActionText::RichText, untyped, Integer | String]
end

class ActiveStorage::Attached::One
  # Delegated to the attachment
  def blob: () -> ActiveStorage::Blob?
  def attachment: () -> ActiveStorage::Attachment?
  def variant: (untyped transformations) -> untyped
  def variable?: () -> bool
  def content_type: () -> String?
  def filename: () -> ActiveStorage::Filename?
  def byte_size: () -> Integer?
end

# Mailers get the route helpers too
class ActionMailer::Base
  include ::_RbsRailsPathHelpers
end

# Newer than the actionpack collection signatures
module ActionController::RequestForgeryProtection
  private

  def verified_via_header_only?: () -> bool
  def sec_fetch_site_value: () -> String?
end

class Time
  # The app always configures Time.zone
  def self.current: () -> ActiveSupport::TimeWithZone
                  | ...
end

class ActiveStorage::Attachment
  def blob_id: () -> String
end

class ActiveRecord::Base
  include GlobalID::Identification

  # Association extensions: `has_many :things do ... end`
  def self.has_many: (Symbol, ?untyped, **untyped) { () -> void } -> void
                   | ...
end

module ActiveRecord::Relation::Methods[Model, PrimaryKey]
  # Without a block, returns an enumerator of batches
  def in_batches: (?of: Integer, ?start: Integer, ?finish: Integer, ?load: bool, ?error_on_ignore: bool, ?cursor: untyped, ?order: untyped, ?use_ranges: bool?) -> ActiveRecord::Batches::BatchEnumerator
                | ...
end

class ActionMailer::MessageDelivery
  # Delegated to the Mail::Message
  def deliver: () -> Mail::Message
end

class ActiveStorage::VariantRecord
  extend ActiveRecord::Base::ClassMethods[ActiveStorage::VariantRecord, untyped, Integer | String]
end

module ActiveRecord::Base::ClassMethods[Model, Relation, PrimaryKey]
  def maximum: (Symbol | String column_name) -> untyped
end

# Attached::Many delegates missing methods to its
# attachments array (`delegate_missing_to :attachments`).
class ActiveStorage::Attached::Many
  def any?: () -> bool
          | () { (ActiveStorage::Attachment) -> boolish } -> bool
  def to_a: () -> Array[ActiveStorage::Attachment]
end

# lib/action_pack/railtie.rb
class Rails::Railtie
  def self.initializer: (String name, ?Hash[Symbol, untyped] opts) { (Rails::Application app) [self: instance] -> void } -> void
end

class Rails::Application::Configuration
  def action_pack=: (ActiveSupport::OrderedOptions) -> ActiveSupport::OrderedOptions
end

# Query internals used by lib/rails_ext/active_record_optimizer_hints.rb and lib/rails_ext/prepend_order.rb
class ActiveRecord::Relation
  def optimizer_hints_values: () -> Array[String]
  def order_values: () -> Array[untyped]
  def order_values=: (Array[untyped]) -> Array[untyped]
  def quoted_table_name: () -> String
end

class ActiveRecord::Base
  def self.configurations: () -> ActiveRecord::DatabaseConfigurations
end

class ActiveSupport::CurrentAttributes
  def self.set: [T] (**untyped attributes) { () -> T } -> T
end

# Lambda defaults are called for each new record. Typing them as procs gives their bodies a type hint.
module ActiveModel::AttributeRegistration::ClassMethods
  def attribute: (untyped name, ?untyped? type, default: ^() -> untyped, **untyped options) -> untyped
               | ...
end

class ActionController::Base
  # The block runs in the controller instance
  def self.etag: () { () [self: instance] -> untyped } -> void
               | ...
end

# Active Support's html_escape takes any object (calling to_s) and returns a safe buffer
module ERB::Util
  def self?.html_escape: (untyped s) -> ActiveSupport::SafeBuffer
                       | ...
end

class ActionController::Parameters
  type permit_filters = Array[Symbol | Hash[Symbol, untyped]]

  # Typed filters give nested empty arrays (`expect(card: [ :title, tag_ids: [] ])`) a type hint
  def expect: (**permit_filters filters) -> untyped
            | (Hash[Symbol | String, permit_filters] filters) -> untyped
            | ...
end

class Hash[unchecked out K, unchecked out V]
  # A typed argument gives nested empty collections a type hint
  def reverse_merge: (Hash[K, V] other_hash) -> Hash[K, V]
                   | ...

  # A default of the value type: gives an empty default (`fetch(:key, {})`) a type hint
  def fetch: (K key, V default_value) -> V
           | ...
end
