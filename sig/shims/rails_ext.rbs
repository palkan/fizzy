# Framework extensions applied at boot from lib/rails_ext and config/initializers,
# which inline RBS can't see because they're mixed in from outside the class body.

class ActiveRecord::Base
  include ActiveRecordReplicaSupport
  extend ActiveRecordReplicaSupport::ClassMethods
  extend ActiveRecordBaseOptimizerHintExtensions
end

class ActiveRecord::Relation
  prepend ActiveRecordRelationOptimizerHintExtensions
  include ActiveRecordRelationPrependOrder
end

class ActiveRecord::AssociationRelation
  include ActiveRecordRelationPrependOrder
end

class ActiveRecord::ConnectionAdapters::AbstractMysqlAdapter
  prepend MysqlDateArithmetic
end

class ActiveRecord::ConnectionAdapters::SQLite3Adapter
  prepend SqliteDateArithmetic
end

class ActiveStorage::Blob
  prepend ActiveStorageBlobServiceUrlForDirectUploadExpiry

  # lib/rails_ext/active_storage_authorization.rb
  def accessible_to?: (User? user) -> bool
  def publicly_accessible?: () -> bool
end

class ActiveStorage::Attachment
  include Storage::AttachmentTracking

  # lib/rails_ext/active_storage_authorization.rb
  def accessible_to?: (User? user) -> bool?
  def publicly_accessible?: () -> bool?
end

class ActiveStorage::AnalyzeJob
  prepend ActiveStorageAnalyzeJobSkipDetached
  prepend ActiveStorageAnalyzeJobSuppressBroadcasts
end

class ActionMailer::MailDeliveryJob
  include SmtpDeliveryErrorHandling
end

class ActionPack::Passkey
  prepend ActionPackPasskeyInferNameFromAaguid
  extend ActionPackPasskeyInferNameFromAaguid::ClassMethods
end

class Array[unchecked out Elem]
  include ChoiceSentenceArrayConversion
end

# lib/rails_ext/active_storage_authorization.rb defines this module inside a `to_prepare` block
module ActiveStorage::Authorize : ActionController::Base
  extend ActiveSupport::Concern
  include Authentication

  private

  def bearer_token_authenticatable_request?: () -> bool
  def publicly_accessible_blob?: () -> bool
  def ensure_accessible: () -> void
  def http_cache_forever: (?public: bool, **untyped options) { () -> untyped } -> untyped
end
