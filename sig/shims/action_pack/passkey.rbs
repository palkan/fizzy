# lib/action_pack/passkey.rb inherits from a configurable class, which inline RBS can't declare.
# Its columns and associations are generated by rbs_rails into sig/rbs_rails/lib/action_pack/passkey.rbs.
class ActionPack::Passkey < ApplicationRecord
  def self.registration_options: (holder: untyped, **untyped options) -> ActionPack::WebAuthn::PublicKeyCredential::CreationOptions
  def self.register: (untyped passkey, **untyped attributes) -> ActionPack::Passkey
  def self.authentication_options: (?holder: untyped, **untyped options) -> ActionPack::WebAuthn::PublicKeyCredential::RequestOptions
  def self.authenticate: (untyped passkey) -> ActionPack::Passkey?

  def authenticate: (untyped passkey) -> ActionPack::Passkey?
  def to_public_key_credential: () -> ActionPack::WebAuthn::PublicKeyCredential
end

# lib/action_pack/passkey/form_helper.rb
class ActionView::Base
  # Included on load by lib/action_pack/railtie.rb
  include ActionPack::Passkey::FormHelper

  # Exposed to views by ActionController::RequestForgeryProtection
  def form_authenticity_token: (?form_options: Hash[untyped, untyped]) -> String

  # Drawn by lib/action_pack/railtie.rb when config.action_pack.passkey.draw_routes is set
  def passkey_challenge_path: (*untyped) -> String
end

# lib/action_pack/railtie.rb adds this to Active Record at load, before ActionPack::Passkey::Holder is included
class ActiveRecord::Base
  def self.has_passkeys: (**untyped options) ?{ (ActionPack::Passkey::Holder::Config) -> void } -> void
end

module ActionPack::Passkey::GeneratedRelationMethods
  def register: (untyped passkey, **untyped attributes) -> ActionPack::Passkey
end
