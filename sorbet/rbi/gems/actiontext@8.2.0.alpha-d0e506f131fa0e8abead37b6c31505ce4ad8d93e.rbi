  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:202
  def visit_tr(node, child_values); end

  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:183
  def visit_ul(node, child_values); end

