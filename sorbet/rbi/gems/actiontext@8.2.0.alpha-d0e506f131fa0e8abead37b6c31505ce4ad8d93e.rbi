  def visit_pre(_node, child_values); end

  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:137
  def visit_s(_node, child_values); end

  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:234
  def visit_script(_node, _child_values); end

  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:113
  def visit_strong(node, child_values); end

  # pkg:gem/actiontext#lib/action_text/markdown_conversion.rb:235
