  def initialize(max_size: T.unsafe(nil), name: T.unsafe(nil)); end

  # pkg:gem/actioncable#lib/action_cable/server/base.rb:20
  def post(task = T.unsafe(nil), &block); end

  # pkg:gem/actioncable#lib/action_cable/server/base.rb:29
  def shutdown; end

  # pkg:gem/actioncable#lib/action_cable/server/base.rb:25
  def timer(interval, &block); end
end

# Worker used by Server.send_async to do connection work in threads.
#
# pkg:gem/actioncable#lib/action_cable/server/worker.rb:12
class ActionCable::Server::Worker
  include ::ActiveSupport::Callbacks
  include ::ActionCable::Server::Worker::ActiveRecordConnectionManagement
  extend ::ActiveSupport::Callbacks::ClassMethods
  extend ::ActiveSupport::DescendantsTracker

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:21
  def initialize(max_size: T.unsafe(nil)); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:13
  def __callbacks; end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:16
  def _run_work_callbacks(&block); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:16
  def _run_work_callbacks!(&block); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:16
  def _work_callbacks; end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:48
  def async_exec(receiver, *args, connection:, &block); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:52
  def async_invoke(receiver, method, *args, connection: T.unsafe(nil), &block); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:15
  def connection; end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:15
  def connection=(obj); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:19
  def executor; end

  # Stop processing work: any work that has not already started running will be
  # discarded from the queue
  #
  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:32
  def halt; end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:58
  def invoke(receiver, method, *args, connection:, &block); end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:36
  def stopping?; end

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:40
  def work(connection, &block); end

  private

  # pkg:gem/actioncable#lib/action_cable/server/worker.rb:70
  def logger; end

  class << self
    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:13
    def __callbacks; end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:13
    def __callbacks=(value); end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:13
    def __class_attr___callbacks; end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:16
    def _work_callbacks; end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:16
    def _work_callbacks=(value); end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:15
    def connection; end

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:15
    def connection=(obj); end

    private

    # pkg:gem/actioncable#lib/action_cable/server/worker.rb:13
    def __class_attr___callbacks_owner; end
  end
end

