# typed: true

# Constants referenced by generated RBIs but missing from them

# Removed from edge Active Support, still referenced by Tapioca's Active Record compilers
module ActiveSupport::Multibyte
  class Chars; end
end

# zip_kit ships an RBI generated by sord, with placeholders for types sord couldn't resolve
SORD_ERROR_ZlibDeflater = T.type_alias { T.untyped }

# Its signatures refer to the readers by short name from ZipEntry, where they don't resolve
class ZipKit::FileReader::ZipEntry
  StoredReader = ZipKit::FileReader::StoredReader
  InflatingReader = ZipKit::FileReader::InflatingReader
end

# Loaded lazily, referenced by the actionpack annotations
class ActionDispatch::Request::Session; end
